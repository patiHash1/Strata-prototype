package templates

// MetricsChart renders an ApexCharts line graph using Alpine.js.
// It fetches real runtime metrics from the backend JSON endpoint every 5 seconds.
templ MetricsChart() {
	<div
		class="card"
		x-data="metricsChart()"
		x-init="$nextTick(() => initChart())"
	>
		<div class="card-header">
			<h3 class="card-header-title">Real-Time Metrics</h3>
		</div>
		<div class="card-body">
			<div id="metrics-chart" style="min-height: 300px;"></div>
		</div>
	</div>
	<script>
		function metricsChart() {
			return {
				chart: null,

				initChart() {
					if (typeof ApexCharts === 'undefined') {
						setTimeout(() => this.initChart(), 200);
						return;
					}

					const options = {
						chart: {
							id: 'metrics-line-chart',
							type: 'line',
							height: 300,
							animations: { enabled: true, easing: 'easeinout', speed: 400 },
							toolbar: { show: false },
							background: 'transparent',
						},
						stroke: { curve: 'smooth', width: 2 },
						colors: ['#00ADD8', '#7B42BC', '#2EA043', '#D97706'],
						series: [
							{ name: 'Memory (MB)', data: [] },
							{ name: 'Goroutines', data: [] },
							{ name: 'DB Connections', data: [] },
							{ name: 'Active Users', data: [] },
						],
					xaxis: { type: 'datetime', labels: { style: { colors: '#9CA3AF' } } },
					yaxis: { labels: { style: { colors: '#9CA3AF' } } },
					grid: { borderColor: '#374151', strokeDashArray: 4 },
					legend: { labels: { colors: '#9CA3AF' } },
					tooltip: { theme: 'dark' },
				};

					this.chart = new ApexCharts(document.querySelector('#metrics-chart'), options);
					this.chart.render().then(() => {
						this.fetchMetrics();
						setInterval(() => this.fetchMetrics(), 5000);
					});
				},

				fetchMetrics() {
					if (!this.chart) {
						setTimeout(() => this.fetchMetrics(), 500);
						return;
					}
					fetch('/api/v1/super-admin/metrics/json', { credentials: 'same-origin' })
					.then(r => r.json())
					.then(json => {
						if (!json.metrics || !this.chart) return;
						const m = json.metrics;
						const now = Date.now();
						const runtime = m.runtime || {};
						const db = m.db || {};
						const http = m.http || {};

						this.chart.appendData([
							{ data: [{ x: now, y: runtime.allocated_mb || 0 }] },
							{ data: [{ x: now, y: runtime.goroutines || 0 }] },
							{ data: [{ x: now, y: db.acquired_conns || 0 }] },
							{ data: [{ x: now, y: http.total_requests || 0 }] },
						]);

						// Keep at most 60 data points (5 minutes at 5s intervals).
						const series = this.chart.w.globals.series;
						if (series[0] && series[0].length > 60) {
							const start = series[0].length - 60;
							this.chart.updateSeries(series.map(s => ({ data: s.slice(start) })));
						}
					})
					.catch(() => {});
				},
			};
		}
	</script>
}

// SuperAdminMetricsView renders the /metrics page showing low-level runtime
// telemetry, database performance, and infrastructure profiling.
templ SuperAdminMetricsView() {
	@SuperAdminLayout("Metrics") {
		<div class="dashboard-shell">
			<!-- Page header -->
			<div>
				<h1 class="page-title">Metrics</h1>
				<p class="page-subtitle">Runtime telemetry, database performance, and infrastructure profiling.</p>
			</div>
			<!-- Runtime metrics grid with HTMX polling -->
			<div
				id="metrics-grid"
				hx-get="/api/v1/super-admin/metrics/fragment"
				hx-trigger="load, every 5s"
				hx-swap="outerHTML"
			>
				@MetricsGrid(SystemMetricsView{})
			</div>
			<!-- ApexCharts real-time line graph -->
			@MetricsChart()
		</div>
	}
}
