package templates

// MetricsChart renders an ApexCharts line graph using Alpine.js.
// It fetches real runtime metrics from the backend JSON endpoint every 5 seconds.
templ MetricsChart() {
	<div
		class="card"
		x-data="metricsChart()"
		x-init="$nextTick(() => initChart())"
	>
		<div class="card-header">
			<h3 class="card-header-title">Real-Time Metrics</h3>
			<div class="card-header-actions">
				<button
					class="btn-sm"
					:class="timeframe === 'daily' ? 'btn-primary' : 'btn-secondary'"
					@click="setRange('daily')"
				>24h</button>
				<button
					class="btn-sm"
					:class="timeframe === 'weekly' ? 'btn-primary' : 'btn-secondary'"
					@click="setRange('weekly')"
				>7d</button>
			</div>
		</div>
		<div class="card-body">
			<div x-ref="chart" id="metrics-chart" style="min-height: 300px;"></div>
		</div>
	</div>
	<script>
		function metricsChart() {
			// Global in-memory buffer shared across component remounts so
			// navigating away and back preserves the collected history.
			const metricsStore = window.__strataMetricsStore || (window.__strataMetricsStore = {
				points: [],
			});

			return {
				chart: null,
				pollTimer: null,
				resizeObserver: null,
				timeframe: 'daily',
				allPoints: [],

				initChart() {
					if (typeof ApexCharts === 'undefined') {
						setTimeout(() => this.initChart(), 200);
						return;
					}

					// Restore any previously collected points before mounting the chart.
					this.allPoints = metricsStore.points.slice();

					const DAY = 24 * 60 * 60 * 1000;
					const now = Date.now();

					const options = {
						chart: {
							id: 'metrics-line-chart',
							type: 'line',
							height: 300,
							animations: { enabled: true, easing: 'easeinout', speed: 400 },
							toolbar: { show: false },
							background: 'transparent',
						},
						stroke: { curve: 'smooth', width: 2 },
						colors: ['#00ADD8', '#7B42BC', '#2EA043', '#D97706'],
						series: [
							{ name: 'Memory (MB)', data: [] },
							{ name: 'Goroutines', data: [] },
							{ name: 'DB Connections', data: [] },
							{ name: 'Active Users', data: [] },
						],
						xaxis: {
							type: 'datetime',
							min: now - DAY,
							max: now,
							labels: {
								style: { colors: '#9CA3AF' },
								datetimeUTC: false,
								formatter: function(val) {
									return new Date(val).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
								},
							},
						},
						yaxis: { min: 0, labels: { style: { colors: '#9CA3AF' } } },
						grid: { borderColor: '#374151', strokeDashArray: 4 },
						legend: { labels: { colors: '#9CA3AF' } },
						tooltip: { theme: 'dark' },
					};

					this.chart = new ApexCharts(this.$refs.chart, options);
					this.chart.render().then(() => {
						// Watch container size. On remount via HTMX the div may
						// start at 0×0 — wait for a real clientWidth before
						// trying resize + rebuild.
						if (typeof ResizeObserver !== 'undefined') {
							this.resizeObserver = new ResizeObserver((entries) => {
								for (const e of entries) {
									if (e.contentRect.width > 0 && this.chart) {
										this.chart.resize();
										this.rebuildChart();
									}
								}
							});
							this.resizeObserver.observe(this.$refs.chart);
						} else {
							// Fallback for older browsers.
							requestAnimationFrame(() => {
								if (this.chart) { this.chart.resize(); }
							});
						}

						this.fetchMetrics();
						this.pollTimer = setInterval(() => this.fetchMetrics(), 5000);
					});

					// Reinitialize chart when page is restored from bfcache.
					window.addEventListener('pageshow', (e) => {
						if (e.persisted) {
							if (this.pollTimer) { clearInterval(this.pollTimer); this.pollTimer = null; }
							if (this.chart) { this.chart.destroy(); this.chart = null; }
							this.allPoints = metricsStore.points.slice();
							this.initChart();
						}
					});
				},

				setRange(tf) {
					this.timeframe = tf;
					if (!this.chart) return;

					const now = Date.now();
					const DAY = 24 * 60 * 60 * 1000;
					const rangeMs = tf === 'daily' ? DAY : 7 * DAY;

					// Dynamic x-axis formatter: clock times for ≤24h, dates for multi-day.
					const isMultiDay = tf === 'weekly';
					const xaxisFormatter = isMultiDay
						? function(val) {
							const d = new Date(val);
							return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
						  }
						: function(val) {
							return new Date(val).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
						  };

					this.chart.updateOptions({
						xaxis: {
							min: now - rangeMs,
							max: now,
							labels: { formatter: xaxisFormatter },
						},
						title: {
							text: isMultiDay ? '7-Day Rolling Max' : '24h Rolling Average',
							style: { color: '#9CA3AF', fontSize: '12px' },
						},
					}, false);

					this.rebuildChart();
				},

				rebuildChart() {
					if (!this.chart) return;
					const now = Date.now();
					const DAY = 24 * 60 * 60 * 1000;
					const rangeMs = this.timeframe === 'daily' ? DAY : 7 * DAY;
					const bins = this.timeframe === 'daily' ? 24 : 7;
					const cutoff = now - rangeMs;
					const inRange = this.allPoints.filter(p => p.ts >= cutoff);

					if (inRange.length === 0) {
						this.chart.updateSeries([
							{ name: 'Memory (MB)', data: [] },
							{ name: 'Goroutines', data: [] },
							{ name: 'DB Connections', data: [] },
							{ name: 'Active Users', data: [] },
						]);
						this.chart.updateOptions({
							xaxis: { min: cutoff, max: now },
						}, false);
						return;
					}

					const binSize = rangeMs / bins;
					const aggregated = [[], [], [], []];
					for (let b = 0; b < bins; b++) {
						const binStart = cutoff + b * binSize;
						const binEnd = binStart + binSize;
						const inBin = inRange.filter(p => p.ts >= binStart && p.ts < binEnd);
						const binTimestamp = binStart + binSize / 2;
						for (let s = 0; s < 4; s++) {
							if (inBin.length > 0) {
								if (this.timeframe === 'weekly') {
									const max = Math.max(...inBin.map(p => p.values[s]));
									aggregated[s].push({ x: binTimestamp, y: max });
								} else {
									const sum = inBin.reduce((a, p) => a + p.values[s], 0);
									aggregated[s].push({ x: binTimestamp, y: parseFloat((sum / inBin.length).toFixed(2)) });
								}
							} else {
								aggregated[s].push({ x: binTimestamp, y: 0 });
							}
						}
					}

					const seriesNames = ['Memory (MB)', 'Goroutines', 'DB Connections', 'Active Users'];
					this.chart.updateSeries(seriesNames.map((name, i) => ({ name, data: aggregated[i] })), true);
					this.chart.updateOptions({
						xaxis: { min: cutoff, max: now },
					}, false);
				},

				fetchMetrics() {
					if (!this.chart) {
						setTimeout(() => this.fetchMetrics(), 500);
						return;
					}
					fetch('/api/v1/super-admin/metrics/json', { credentials: 'same-origin' })
					.then(r => r.json())
					.then(json => {
						if (!json.metrics || !this.chart) return;
						const m = json.metrics;
						const now = Date.now();
						const runtime = m.runtime || {};
						const db = m.db || {};

						this.allPoints.push({
							ts: now,
							values: [
								parseFloat((runtime.allocated_mb || 0).toFixed(2)),
								runtime.goroutines || 0,
								db.acquired_conns || 0,
								m.active_users || 0,
							],
						});

						if (this.allPoints.length > 20160) {
							this.allPoints = this.allPoints.slice(-20160);
						}

						// Keep the shared store in sync so a later remount can restore
						// the chart immediately before the next live sample arrives.
						metricsStore.points = this.allPoints.slice();

						this.rebuildChart();
					})
					.catch(() => {});
				},

				destroy() {
					if (this.pollTimer) { clearInterval(this.pollTimer); this.pollTimer = null; }
					if (this.resizeObserver) { this.resizeObserver.disconnect(); this.resizeObserver = null; }
					if (this.chart) { this.chart.destroy(); this.chart = null; }
					// Persist collected points so they survive component unmount.
					metricsStore.points = this.allPoints.slice();
				},
			};
		}
</script>
}

// SuperAdminMetricsView renders the /metrics page showing low-level runtime
// telemetry, database performance, and infrastructure profiling.
templ SuperAdminMetricsView() {
	@SuperAdminLayout("Metrics") {
		<div class="dashboard-shell">
			<!-- Page header -->
			<div>
				<h1 class="page-title">Metrics</h1>
				<p class="page-subtitle">Runtime telemetry, database performance, and infrastructure profiling.</p>
			</div>
			<!-- Runtime metrics grid with HTMX polling -->
			<div
				id="metrics-grid"
				hx-get="/api/v1/super-admin/metrics/fragment"
				hx-trigger="load, every 5s"
				hx-swap="outerHTML"
			>
				@MetricsGrid(SystemMetricsView{})
			</div>
			<!-- ApexCharts real-time line graph -->
			@MetricsChart()
		</div>
	}
}