package templates

import (
	"fmt"
	"time"

	"github.com/patiHash1/Strata-prototype/internal/templates/components"
)

// SystemMetricsView holds the real-time observability data for the dashboard.
type SystemMetricsView struct {
	AllocatedMB   float64
	GCRuns        uint32
	Goroutines    int
	HeapObjects   uint64
	AcquiredConns int32
	IdleConns     int32
	TotalConns    int32
	MaxConns      int32
}

// SecurityEvent holds a single SOC security event for the live feed.
type SecurityEvent struct {
	ID        string
	Type      string
	Severity  string
	Message   string
	IPAddress string
	Timestamp time.Time
}

templ SuperAdminDashboardView() {
	@SuperAdminLayout("Dashboard") {
		<div class="dashboard-shell">
			<!-- Page header -->
			<div>
				<h1 class="page-title">Dashboard</h1>
				<p class="page-subtitle">System overview and key metrics at a glance.</p>
			</div>

			<!-- Metrics grid with HTMX polling -->
			<div
				id="metrics-grid"
				hx-get="/api/v1/super-admin/metrics/fragment"
				hx-trigger="load, every 5s"
				hx-swap="outerHTML"
			>
				@MetricsGrid(SystemMetricsView{})
			</div>

			<!-- Quick actions -->
			<div class="content-grid">
				@components.Card("Quick Actions") {
					<div>
						<p class="quick-actions-text">Common administrative tasks available to super admins.</p>
						<div class="quick-actions-btn-group">
							@components.PrimaryButton("View Metrics", templ.Attributes{
								"hx-get":    "/api/v1/super-admin/metrics",
								"hx-target": "#metrics-output",
								"hx-swap":   "innerHTML",
							})
							@components.PrimaryButton("Health Check", templ.Attributes{
								"hx-get":    "/api/v1/super-admin/health",
								"hx-target": "#metrics-output",
								"hx-swap":   "innerHTML",
							})
						</div>
						<div id="metrics-output" class="metrics-output"></div>
					</div>
				}
				@components.Card("Recent Activity") {
					<div class="activity-list">
						<div class="activity-item">
							@components.Badge("Deploy", "purple")
							<span class="activity-text">v0.1.0 deployed to production</span>
							<span class="activity-time">2h ago</span>
						</div>
						<div class="activity-item">
							@components.Badge("Alert", "yellow")
							<span class="activity-text">Disk usage at 78% on db-primary</span>
							<span class="activity-time">5h ago</span>
						</div>
						<div class="activity-item">
							@components.Badge("User", "blue")
							<span class="activity-text">New org registered: Acme Corp</span>
							<span class="activity-time">1d ago</span>
						</div>
					</div>
				}
			</div>

			<!-- ApexCharts real-time line graph -->
			@MetricsChart()

			<!-- Live security feed -->
			@components.Card("Live Security Feed") {
				@SSEFeed()
			}
		</div>
	}
}

// MetricsGrid renders the four metric cards as an HTMX-swappable fragment.
// It does NOT include the full HTML layout shell — only the grid div.
templ MetricsGrid(metrics SystemMetricsView) {
	<div id="metrics-grid" class="metrics-grid">
		@components.Card("Runtime Memory") {
			<div class="stat-container">
				<span class="stat-number">{ fmt.Sprintf("%.1f MB", metrics.AllocatedMB) }</span>
				@components.Badge(fmt.Sprintf("%d GC", metrics.GCRuns), "blue")
			</div>
			<p class="stat-caption">{ fmt.Sprintf("%d goroutines · %d heap objects", metrics.Goroutines, metrics.HeapObjects) }</p>
		}
		@components.Card("DB Connections") {
			<div class="stat-container">
				<span class="stat-number">{ fmt.Sprintf("%d", metrics.AcquiredConns) }</span>
				@components.Badge(fmt.Sprintf("%d idle", metrics.IdleConns), "green")
			</div>
			<p class="stat-caption">{ fmt.Sprintf("%d total / %d max", metrics.TotalConns, metrics.MaxConns) }</p>
		}
		@components.Card("Goroutines") {
			<div class="stat-container">
				<span class="stat-number">{ fmt.Sprintf("%d", metrics.Goroutines) }</span>
				@components.Badge("Live", "strata")
			</div>
			<p class="stat-caption">Active goroutines</p>
		}
		@components.Card("System Status") {
			<div class="stat-container">
				<span class="stat-number">99.9%</span>
				@components.Badge("Uptime", "green")
			</div>
			<p class="stat-caption">30-day rolling average</p>
		}
	</div>
}

// MetricsChart renders an ApexCharts line graph using Alpine.js.
// It listens to HTMX afterSwap events to update data series dynamically
// without fully redrawing the chart canvas.
templ MetricsChart() {
	<div
		class="card"
		x-data="metricsChart()"
		x-init="initChart()"
		@@htmx:afterSwap.window="onMetricsUpdate($event)"
	>
		<div class="card-header">
			<h3 class="card-header-title">Real-Time Metrics</h3>
		</div>
		<div class="card-body">
			<div id="metrics-chart" style="min-height: 300px;"></div>
		</div>
	</div>
	<script>
		function metricsChart() {
			return {
				chart: null,
				seriesData: [],

				initChart() {
					if (typeof ApexCharts === 'undefined') {
						// ApexCharts CDN not loaded yet; retry on next tick.
						setTimeout(() => this.initChart(), 200);
						return;
					}

					const options = {
						chart: {
							id: 'metrics-line-chart',
							type: 'line',
							height: 300,
							animations: {
								enabled: true,
								easing: 'easeinout',
								speed: 400,
								animateGradually: {
									enabled: true,
									delay: 100,
								},
							},
							toolbar: { show: false },
							background: 'transparent',
						},
						stroke: {
							curve: 'smooth',
							width: 2,
						},
						colors: ['#00ADD8', '#7B42BC', '#2EA043', '#D97706'],
						series: [
							{ name: 'Memory (MB)', data: [] },
							{ name: 'Goroutines', data: [] },
							{ name: 'DB Conns', data: [] },
							{ name: 'Heap Objects (÷100)', data: [] },
						],
						xaxis: {
							type: 'datetime',
							labels: {
								style: { colors: '#9CA3AF' },
							},
						},
						yaxis: {
							labels: {
								style: { colors: '#9CA3AF' },
							},
						},
						grid: {
							borderColor: '#374151',
							strokeDashArray: 4,
						},
						legend: {
							labels: {
								colors: '#9CA3AF',
							},
						},
						tooltip: {
							theme: 'dark',
						},
					};

					this.chart = new ApexCharts(document.querySelector('#metrics-chart'), options);
					this.chart.render();
				},

				onMetricsUpdate(event) {
					// Only react to swaps targeting our metrics grid.
					const target = event.detail.target;
					if (!target || target.id !== 'metrics-grid') return;

					if (!this.chart) return;

					const now = Date.now();

					// Parse metric values from the swapped HTML.
					const html = target.innerHTML;
					const memMatch = html.match(/([\d.]+)\s*MB/);
					const gorMatch = html.match(/(\d+)\s*goroutines/);
					const connMatch = html.match(/(\d+)\s*total/);
					const heapMatch = html.match(/(\d+)\s*heap objects/);

					const memVal = memMatch ? parseFloat(memMatch[1]) : 0;
					const gorVal = gorMatch ? parseInt(gorMatch[1], 10) : 0;
					const connVal = connMatch ? parseInt(connMatch[1], 10) : 0;
					const heapVal = heapMatch ? parseInt(heapMatch[1], 10) / 100 : 0;

					// Append new data point to each series.
					this.chart.appendData([
						{ data: [memVal] },
						{ data: [gorVal] },
						{ data: [connVal] },
						{ data: [heapVal] },
					]);

					// Keep at most 60 data points (5 minutes at 5s intervals).
					const series = this.chart.w.globals.series;
					if (series[0] && series[0].length > 60) {
						const sliceStart = series[0].length - 60;
						const newSeries = series.map(s => ({
							data: s.slice(sliceStart),
						}));
						this.chart.updateSeries(newSeries);
					}
				},
			};
		}
	</script>
}

// SSEFeed renders an HTMX SSE-connected container that listens for
// security-event messages and swaps new log entries at the top of the list.
templ SSEFeed() {
	<div
		hx-ext="sse"
		sse-connect="/api/v1/super-admin/security/stream"
		sse-swap="security-event"
		hx-swap="afterbegin"
		class="sse-feed"
	>
		<div class="sse-feed-empty">
			<svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
			</svg>
			<p>Waiting for security events…</p>
		</div>
	</div>
}

// SecurityLogEntry renders a single SOC security event as an HTML element
// suitable for SSE streaming. It is wrapped in a <div> that HTMX can swap
// into the feed container.
templ SecurityLogEntry(event SecurityEvent) {
	<div class={ "sse-entry", "sse-severity-"+event.Severity }>
		<div class="sse-entry-header">
			<span class="sse-entry-type">{ event.Type }</span>
			@components.Badge(event.Severity, event.Severity)
			if event.IPAddress != "" {
				<span class="sse-entry-ip">{ event.IPAddress }</span>
			}
			<span class="sse-entry-time">{ event.Timestamp.Format("15:04:05") }</span>
		</div>
		<p class="sse-entry-message">{ event.Message }</p>
	</div>
}