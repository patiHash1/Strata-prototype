package templates

import (
	"github.com/patiHash1/Strata-prototype/internal/templates/components"
)

templ SuperAdminDashboardView() {
	@SuperAdminLayout("Dashboard") {
		<div class="dashboard-shell">
			<!-- Page header -->
			<div>
				<h1 class="page-title">Dashboard</h1>
				<p class="page-subtitle">System overview and key metrics at a glance.</p>
			</div>

			<!-- Metrics cards row -->
			<div class="metrics-grid">
				@components.Card("Total Users") {
					<div class="stat-container">
						<span class="stat-number">1,248</span>
						@components.Badge("+12%", "green")
					</div>
					<p class="stat-caption">Active accounts across all orgs</p>
				}
				@components.Card("Organizations") {
					<div class="stat-container">
						<span class="stat-number">86</span>
						@components.Badge("+3", "blue")
					</div>
					<p class="stat-caption">Registered tenants</p>
				}
				@components.Card("API Requests") {
					<div class="stat-container">
						<span class="stat-number">42.8k</span>
						@components.Badge("Healthy", "strata")
					</div>
					<p class="stat-caption">Last 24 hours</p>
				}
				@components.Card("System Status") {
					<div class="stat-container">
						<span class="stat-number">99.9%</span>
						@components.Badge("Uptime", "green")
					</div>
					<p class="stat-caption">30-day rolling average</p>
				}
			</div>

			<!-- Quick actions -->
			<div class="content-grid">
				@components.Card("Quick Actions") {
					<div>
						<p class="quick-actions-text">Common administrative tasks available to super admins.</p>
						<div class="quick-actions-btn-group">
							@components.PrimaryButton("View Metrics", templ.Attributes{
								"hx-get":    "/api/v1/super-admin/metrics",
								"hx-target": "#metrics-output",
								"hx-swap":   "innerHTML",
							})
							@components.PrimaryButton("Health Check", templ.Attributes{
								"hx-get":    "/api/v1/super-admin/health",
								"hx-target": "#metrics-output",
								"hx-swap":   "innerHTML",
							})
						</div>
						<div id="metrics-output" class="metrics-output"></div>
					</div>
				}
				@components.Card("Recent Activity") {
					<div class="activity-list">
						<div class="activity-item">
							@components.Badge("Deploy", "purple")
							<span class="activity-text">v0.1.0 deployed to production</span>
							<span class="activity-time">2h ago</span>
						</div>
						<div class="activity-item">
							@components.Badge("Alert", "yellow")
							<span class="activity-text">Disk usage at 78% on db-primary</span>
							<span class="activity-time">5h ago</span>
						</div>
						<div class="activity-item">
							@components.Badge("User", "blue")
							<span class="activity-text">New org registered: Acme Corp</span>
							<span class="activity-time">1d ago</span>
						</div>
					</div>
				}
			</div>
		</div>
	}
}