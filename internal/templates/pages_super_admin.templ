package templates

import (
	"fmt"
	"time"

	"github.com/patiHash1/Strata-prototype/internal/templates/components"
)

// SystemMetricsView holds the real-time observability data for the dashboard.
type SystemMetricsView struct {
	AllocatedMB   float64
	GCRuns        uint32
	Goroutines    int
	HeapObjects   uint64
	AcquiredConns int32
	IdleConns     int32
	TotalConns    int32
	MaxConns      int32
}

// SecurityEvent holds a single SOC security event for the live feed.
type SecurityEvent struct {
	ID        string
	Type      string
	Severity  string
	Message   string
	IPAddress string
	Timestamp time.Time
}

// DashboardKPIs holds the real-time KPI values for the dashboard.
type DashboardKPIs struct {
	SystemUptime         string
	ActiveOrganizations  int
	TotalActiveUsers     int
	SecurityAlerts       int
}

// ActivityItem holds a single recent activity entry.
type ActivityItem struct {
	Severity  string
	Message   string
	Timestamp string
}

// TrafficDataPoint is the JSON shape returned by the traffic chart endpoint.
type TrafficDataPoint struct {
	Timestamp int64 `json:"ts"`
	Count2xx  int64 `json:"count_2xx"`
	Count5xx  int64 `json:"count_5xx"`
}

// SuperAdminDashboardView renders the high-level platform health dashboard
// with real-time KPIs, API traffic, and recent activity.
templ SuperAdminDashboardView() {
	@SuperAdminLayout("Dashboard") {
		<div class="dashboard-shell">
			<!-- Page header with quick actions -->
			<div class="dashboard-header">
				<div>
					<h1 class="page-title">Dashboard</h1>
					<p class="page-subtitle">Platform health, key performance indicators, and critical alerts.</p>
				</div>
				<div class="dashboard-actions">
					<a href="/api/v1/super-admin/metrics" class="btn-primary">
						View Metrics
					</a>
					<button
						type="button"
						class="btn-primary"
						hx-get="/api/v1/super-admin/health"
						hx-target="#health-output"
						hx-swap="innerHTML"
					>
						Health Check
					</button>
					<div id="health-output" class="health-output"></div>
				</div>
			</div>
			<!-- Top KPI Bar — HTMX polls every 10s -->
			<div
				id="dashboard-kpis"
				hx-get="/api/v1/super-admin/dashboard/kpis"
				hx-trigger="load, every 10s"
				hx-swap="innerHTML"
			>
				@DashboardKPIGrid(DashboardKPIs{})
			</div>
			<!-- Bottom row: API Traffic (65%) + Recent Activity (35%) -->
			<div class="dashboard-bottom-row">
				<!-- Global API Traffic Chart (65%) -->
				<div class="dashboard-bottom-chart" style="flex: 65;">
					@APITrafficChart()
				</div>
				<!-- Recent Activity Feed (35%) -->
				<div class="dashboard-bottom-activity" style="flex: 35;">
					@DashboardActivityPanel()
				</div>
			</div>
		</div>
	}
}

// DashboardKPIGrid renders the four KPI cards as an HTMX-swappable fragment.
templ DashboardKPIGrid(kpis DashboardKPIs) {
	<div id="dashboard-kpis" class="kpi-grid">
		@KPICard("System Uptime", kpis.SystemUptime, "Uptime", "green", "30-day rolling average")
		@KPICard("Active Organizations", fmt.Sprintf("%d", kpis.ActiveOrganizations), "Active", "strata", "Across all tenants")
		@KPICard("Global Users", fmt.Sprintf("%d", kpis.TotalActiveUsers), "Active", "blue", "Registered users")
		@KPICard("Security Alerts", fmt.Sprintf("%d", kpis.SecurityAlerts), alertBadge(kpis.SecurityAlerts), alertBadgeColor(kpis.SecurityAlerts), alertCaption(kpis.SecurityAlerts))
	</div>
}

// DashboardActivityPanel renders the recent activity panel with HTMX polling.
templ DashboardActivityPanel() {
	<div
		id="dashboard-activity"
		hx-get="/api/v1/super-admin/dashboard/activity"
		hx-trigger="load, every 15s"
		hx-swap="innerHTML"
	>
		@components.Card("Recent Activity") {
			<div class="activity-list">
				<div class="activity-empty">Loading recent activity…</div>
			</div>
		}
	</div>
}

// DashboardActivityList renders the activity items as an HTMX-swappable fragment.
templ DashboardActivityList(items []ActivityItem) {
	<div id="dashboard-activity">
		@components.Card("Recent Activity") {
			<div class="activity-list">
				if len(items) == 0 {
					<div class="activity-empty">No recent activity.</div>
				}
				for _, item := range items {
					<div class="activity-item">
						@components.Badge(item.Severity, severityBadgeColor(item.Severity))
						<span class="activity-text">{ item.Message }</span>
						<span class="activity-time">{ item.Timestamp }</span>
					</div>
				}
			</div>
		}
	</div>
}

// KPICard renders a high-level KPI metric card for the dashboard.
templ KPICard(title string, value string, badgeLabel string, badgeColor string, caption string) {
	<div class="card">
		<div class="card-header">
			<h3 class="card-header-title">{ title }</h3>
		</div>
		<div class="card-body">
			<div class="stat-container">
				<span class="stat-number">{ value }</span>
				@components.Badge(badgeLabel, badgeColor)
			</div>
			<p class="stat-caption">{ caption }</p>
		</div>
	</div>
}

// MetricsGrid renders the four metric cards as an HTMX-swappable fragment.
// It does NOT include the full HTML layout shell — only the grid div.
templ MetricsGrid(metrics SystemMetricsView) {
	<div id="metrics-grid" class="metrics-grid">
		@components.Card("Runtime Memory") {
			<div class="stat-container">
				<span class="stat-number">{ fmt.Sprintf("%.2f MB", metrics.AllocatedMB) }</span>
				@components.Badge(fmt.Sprintf("%d GC", metrics.GCRuns), "blue")
			</div>
			<p class="stat-caption">{ fmt.Sprintf("%d goroutines · %d heap objects", metrics.Goroutines, metrics.HeapObjects) }</p>
		}
		@components.Card("DB Connections") {
			<div class="stat-container">
				<span class="stat-number">{ fmt.Sprintf("%d", metrics.AcquiredConns) }</span>
				@components.Badge(fmt.Sprintf("%d idle", metrics.IdleConns), "green")
			</div>
			<p class="stat-caption">{ fmt.Sprintf("%d total / %d max", metrics.TotalConns, metrics.MaxConns) }</p>
		}
		@components.Card("Goroutines") {
			<div class="stat-container">
				<span class="stat-number">{ fmt.Sprintf("%d", metrics.Goroutines) }</span>
				@components.Badge("Live", "strata")
			</div>
			<p class="stat-caption">Active goroutines</p>
		}
		@components.Card("System Status") {
			<div class="stat-container">
				<span class="stat-number">99.9%</span>
				@components.Badge("Uptime", "green")
			</div>
			<p class="stat-caption">30-day rolling average</p>
		}
	</div>
}

// SSEFeed renders an HTMX SSE-connected container that listens for
// security-event messages and swaps new log entries at the top of the list.
templ SSEFeed() {
	<div
		hx-ext="sse"
		sse-connect="/api/v1/super-admin/security/stream"
		sse-swap="security-event"
		hx-swap="afterbegin"
		class="sse-feed"
	>
		<div class="sse-feed-empty">
			<svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
			</svg>
			<p>Waiting for security events…</p>
		</div>
	</div>
}

// SecurityLogEntry renders a single SOC security event as an HTML element
// suitable for SSE streaming. It is wrapped in a <div> that HTMX can swap
// into the feed container.
templ SecurityLogEntry(event SecurityEvent) {
	<div class={ "sse-entry", "sse-severity-" + event.Severity }>
		<div class="sse-entry-header">
			<span class="sse-entry-type">{ event.Type }</span>
			@components.Badge(event.Severity, event.Severity)
			if event.IPAddress != "" {
				<span class="sse-entry-ip">{ event.IPAddress }</span>
			}
			<span class="sse-entry-time">{ event.Timestamp.Format("15:04:05") }</span>
		</div>
		<p class="sse-entry-message">{ event.Message }</p>
	</div>
}

// APITrafficChart renders a high-level API traffic chart showing 2xx vs 5xx throughput.
// It fetches real data from the backend every 60 seconds.
templ APITrafficChart() {
	<div
		class="card"
		x-data="apiTrafficChart()"
		x-init="$nextTick(() => initChart())"
	>
		<div class="card-header">
			<h3 class="card-header-title">Global API Traffic</h3>
			<div class="card-header-actions">
				<button
					class="btn-sm"
					:class="timeframe === 'hourly' ? 'btn-primary' : 'btn-secondary'"
					@click="switchTimeframe('hourly')"
				>1h</button>
				<button
					class="btn-sm"
					:class="timeframe === 'daily' ? 'btn-primary' : 'btn-secondary'"
					@click="switchTimeframe('daily')"
				>24h</button>
			</div>
		</div>
		<div class="card-body">
			<div id="api-traffic-chart" style="min-height: 280px;"></div>
		</div>
	</div>
	<script>
		function apiTrafficChart() {
			return {
				chart: null,
				pollTimer: null,
				timeframe: 'hourly',
				rawSeries: [],

				initChart() {
					if (typeof ApexCharts === 'undefined') {
						setTimeout(() => this.initChart(), 200);
						return;
					}

					const HOURS_1 = 60 * 60 * 1000;
					const now = Date.now();

					const options = {
						chart: {
							id: 'api-traffic-chart',
							type: 'area',
							height: 280,
							animations: { enabled: true, easing: 'easeinout', speed: 400 },
							toolbar: { show: false },
							background: 'transparent',
						},
						stroke: { curve: 'smooth', width: 2 },
						colors: ['#2EA043', '#D97706'],
						series: [
							{ name: '2xx Success', data: [] },
							{ name: '5xx Errors', data: [] },
						],
					xaxis: {
						type: 'datetime',
						min: now - HOURS_1,
						max: now,
						labels: {
							style: { colors: '#9CA3AF' },
							datetimeUTC: false,
							formatter: function(val) {
								return new Date(val).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
							},
						},
					},
					yaxis: { min: 0, labels: { style: { colors: '#9CA3AF' } } },
					grid: { borderColor: '#374151', strokeDashArray: 4 },
					legend: { labels: { colors: '#9CA3AF' } },
					tooltip: { theme: 'dark' },
				};

				this.chart = new ApexCharts(document.querySelector('#api-traffic-chart'), options);
				this.chart.render().then(() => {
					this.fetchTrafficData();
					this.pollTimer = setInterval(() => this.fetchTrafficData(), 15000);
				});

				// Reinitialize chart when page is restored from bfcache.
				window.addEventListener('pageshow', (e) => {
					if (e.persisted) {
						if (this.pollTimer) { clearInterval(this.pollTimer); this.pollTimer = null; }
						if (this.chart) { this.chart.destroy(); this.chart = null; }
						this.rawSeries = [];
						this.initChart();
					}
				});
			},

				switchTimeframe(tf) {
					this.timeframe = tf;
					this.applyData();
				},

				applyData() {
					if (!this.chart || this.rawSeries.length === 0) return;
					const now = Date.now();

					if (this.timeframe === 'hourly') {
						// Last 12 five-minute buckets (1 hour window).
						const cutoff = now - 60 * 60 * 1000;
						const inRange = this.rawSeries.filter(p => p.ts >= cutoff);
						this.chart.updateSeries([
							{ name: '2xx Success', data: inRange.map(p => ({ x: p.ts, y: p.c2xx })) },
							{ name: '5xx Errors', data: inRange.map(p => ({ x: p.ts, y: p.c5xx })) },
						], true);
						this.chart.updateOptions({
							xaxis: { min: cutoff, max: now },
							title: { text: '12 × 5-min buckets', style: { color: '#9CA3AF', fontSize: '12px' } },
						}, false);
					} else {
						// Daily: 24 one-hour slots, highest recorded value per slot.
						const cutoff = now - 24 * 60 * 60 * 1000;
						const inRange = this.rawSeries.filter(p => p.ts >= cutoff);
						const binSize = (24 * 60 * 60 * 1000) / 24; // 1 hour
						const agg2xx = [], agg5xx = [];
						for (let b = 0; b < 24; b++) {
							const binStart = cutoff + b * binSize;
							const binEnd = binStart + binSize;
							const inBin = inRange.filter(p => p.ts >= binStart && p.ts < binEnd);
							if (inBin.length === 0) continue;
							const mid = binStart + binSize / 2;
							agg2xx.push({ x: mid, y: Math.max(...inBin.map(p => p.c2xx)) });
							agg5xx.push({ x: mid, y: Math.max(...inBin.map(p => p.c5xx)) });
						}
						this.chart.updateSeries([
							{ name: '2xx Success', data: agg2xx },
							{ name: '5xx Errors', data: agg5xx },
						], true);
						this.chart.updateOptions({
							xaxis: { min: cutoff, max: now },
							title: { text: '24h Rolling Max (hourly)', style: { color: '#9CA3AF', fontSize: '12px' } },
						}, false);
					}
				},

				fetchTrafficData() {
					if (!this.chart) {
						setTimeout(() => this.fetchTrafficData(), 500);
						return;
					}
					fetch('/api/v1/super-admin/dashboard/traffic', {
						credentials: 'same-origin',
					})
					.then(r => r.json())
					.then(json => {
						if (!json.series || !this.chart) return;
						this.rawSeries = json.series.map(p => ({ ts: p.ts, c2xx: p.count_2xx, c5xx: p.count_5xx }));
						this.applyData();
					})
					.catch(() => {
						// Silently ignore fetch errors
					});
				},

				destroy() {
					if (this.pollTimer) { clearInterval(this.pollTimer); this.pollTimer = null; }
					if (this.chart) { this.chart.destroy(); this.chart = null; }
				},
			};
		}
	</script>
}

// ── Helpers ──

func alertBadge(count int) string {
	if count > 0 {
		return fmt.Sprintf("%d Alert", count)
	}
	return "Clear"
}

func alertBadgeColor(count int) string {
	if count > 0 {
		return "red"
	}
	return "green"
}

func alertCaption(count int) string {
	if count > 0 {
		return "Requires attention"
	}
	return "No critical issues"
}

func severityBadgeColor(severity string) string {
	switch severity {
	case "high", "critical":
		return "red"
	case "medium", "warn":
		return "yellow"
	default:
		return "blue"
	}
}
