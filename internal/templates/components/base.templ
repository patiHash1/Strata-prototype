package components

templ Card(title string) {
	<div class="card">
		if title != "" {
			<div class="card-header">
				<h3 class="card-header-title">{ title }</h3>
			</div>
		}
		<div class="card-body">
			{ children... }
		</div>
	</div>
}

templ Badge(label string, color string) {
	<span class={ "badge", "badge-"+color }>
		{ label }
	</span>
}

templ PrimaryButton(label string, attrs templ.Attributes) {
	<button
		class="btn-primary"
		{ attrs... }
	>
		{ label }
	</button>
}