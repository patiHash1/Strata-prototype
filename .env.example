# ── Required ──────────────────────────────────────────────────
# JWT signing secret — MUST be set in production (no default).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Super-admin credentials — MUST be set in production (no default).
SUPERADMIN_UNAME=admin@strata.local
SUPERADMIN_PWORD=

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgres://strata-user:strata-pass@localhost:5432/strata-db-beta?sslmode=disable

# ── Redis (optional — leave blank to disable) ─────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Server ────────────────────────────────────────────────────
PORT=8080
ENABLE_SWAGGER=true

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Empty = no cross-origin requests.
# Example: https://app.strata.dev,https://admin.strata.dev
ALLOWED_ORIGINS=

# ── JWT ───────────────────────────────────────────────────────
JWT_ISSUER=strata
